# Koya — root env for local development. Copy to .env and fill in.
# Every package loads its own .env first, then this file. Per-package examples
# (packages/mcp-server/.env.example, apps/agent-server/.env.example, apps/web/.env.example)
# list exactly what each deployable needs.

# ── Supabase (server-side only; never expose the service-role key to the browser)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ── Knowledge-base embeddings (optional). Leave EMBEDDINGS_API_KEY empty to use Postgres full-text search.
# openai | voyage
EMBEDDINGS_PROVIDER=openai
EMBEDDINGS_API_KEY=
# default: text-embedding-3-small (openai) / voyage-3.5-lite (voyage)
EMBEDDINGS_MODEL=

# ── MCP server
MCP_PORT=8787
MCP_AUTH_TOKEN=change-me-long-random-string

# ── Agent server
ANTHROPIC_API_KEY=
KOYA_MODEL=claude-haiku-4-5
# Extended thinking: off (default, fastest), light (1,024-token budget, slower on real calls), adaptive
AGENT_THINKING=off
AGENT_MAX_TURNS=8
AGENT_TURN_TIMEOUT_MS=25000
PORT=8080
MCP_SERVER_URL=http://localhost:8787/mcp
VAPI_LLM_SECRET=change-me-shared-with-vapi-custom-llm
VAPI_WEBHOOK_SECRET=change-me-shared-with-vapi-server-url
EVAL_JUDGE=0

# ── Vapi (scripts: pnpm vapi:sync)
# Vapi private API key (dashboard → API Keys). Server-side only.
VAPI_API_KEY=
PUBLIC_AGENT_URL=https://YOUR-SUBDOMAIN.ngrok-free.app

LOG_LEVEL=info

# ── Web app sign-in (signs the session cookie). Generate with: openssl rand -hex 32
SESSION_SECRET=
# Support admin at /admin. Locally defaults to admin / password; in production ADMIN_PASSWORD must be set or admin sign-in stays off.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Website chat: where the web app reaches Koya (the agent server) and the shared secret (same as VAPI_LLM_SECRET there).
KOYA_AGENT_URL=http://localhost:8080

# Shared by the web app and agent server: signs the "signed-in caller" token passed to Koya.
# Generate with: openssl rand -hex 32. Leave empty to disable (callers then verify by voice).
KOYA_IDENTITY_SECRET=
# true: only customers signed in to the dashboard can use Koya by voice. false (default): anyone can, and guests get general help only.
REQUIRE_SIGNED_IN_CALLER=false

# Support-team emails for escalations and callback requests (Resend). Leave the key empty to disable.
RESEND_API_KEY=
SUPPORT_TEAM_EMAIL=support-team@example.com
# Resend's free plan only sends from its shared address until you verify a domain.
EMAIL_FROM=RelayPay Support <onboarding@resend.dev>
