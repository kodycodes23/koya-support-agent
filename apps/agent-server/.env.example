ANTHROPIC_API_KEY=
# Fast model by default because responses are spoken.
KOYA_MODEL=claude-haiku-4-5
# Extended thinking: off (default, fastest), light (1,024-token budget, slower on real calls), adaptive
AGENT_THINKING=off
AGENT_MAX_TURNS=8
AGENT_TURN_TIMEOUT_MS=25000
PORT=8080

MCP_SERVER_URL=http://localhost:8787/mcp
MCP_AUTH_TOKEN=change-me-long-random-string

SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Vapi custom-LLM credential (Bearer) and server-URL secret (x-vapi-secret header).
VAPI_LLM_SECRET=change-me-shared-with-vapi-custom-llm
VAPI_WEBHOOK_SECRET=change-me-shared-with-vapi-server-url

# Vapi private API key, used by `pnpm vapi:sync` to create/update the assistant.
VAPI_API_KEY=
# Public HTTPS URL of this server (e.g. ngrok) that Vapi calls.
PUBLIC_AGENT_URL=https://YOUR-SUBDOMAIN.ngrok-free.app

# 1 = also score scenarios with an LLM judge in `pnpm eval`.
EVAL_JUDGE=0
LOG_LEVEL=info

# Same value as the web app: verifies the signed-in caller token (empty = voice verification only).
KOYA_IDENTITY_SECRET=
# Voice calls must come from a customer signed in to the dashboard (true/false). Needs KOYA_IDENTITY_SECRET.
REQUIRE_SIGNED_IN_CALLER=true
