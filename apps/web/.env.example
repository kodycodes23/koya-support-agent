# Copy to apps/web/.env.local. These are public by design (Vapi web SDK public key).
NEXT_PUBLIC_VAPI_PUBLIC_KEY=
NEXT_PUBLIC_VAPI_ASSISTANT_ID=

# Server-only (never NEXT_PUBLIC_): sign-in and the callback form.
# Locally these are read from the workspace root .env; set them on your host when deploying.
SESSION_SECRET=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
DEMO_LOGIN_HINTS=1
# Same value as the agent server: signs the signed-in caller token for Koya.
KOYA_IDENTITY_SECRET=

# Support-team emails for escalations and callback requests (Resend). Leave the key empty to disable.
RESEND_API_KEY=
SUPPORT_TEAM_EMAIL=support-team@example.com
# Resend's free plan only sends from its shared address until you verify a domain.
EMAIL_FROM=RelayPay Support <onboarding@resend.dev>
