SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
MCP_PORT=8787
# Required when NODE_ENV=production. The agent server sends it as a Bearer token.
MCP_AUTH_TOKEN=change-me-long-random-string
# Optional: enables vector search (otherwise Postgres full-text search).
EMBEDDINGS_PROVIDER=openai
EMBEDDINGS_API_KEY=
EMBEDDINGS_MODEL=
LOG_LEVEL=info

# Support-team emails for escalations and callback requests (Resend). Leave the key empty to disable.
RESEND_API_KEY=
SUPPORT_TEAM_EMAIL=support-team@example.com
# Resend's free plan only sends from its shared address until you verify a domain.
EMAIL_FROM=RelayPay Support <onboarding@resend.dev>
